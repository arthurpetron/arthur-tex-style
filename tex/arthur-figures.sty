\NeedsTeXFormat{LaTeX2e}
\ProvidesPackage{tex/arthur-figures}[2026/04/25 Arthur figure environments]

\RequirePackage{changepage}
\RequirePackage{caption}
\RequirePackage{environ}
\RequirePackage{graphicx}
\RequirePackage{marginnote}

% Fallbacks, so this package still loads on its own; arthur-margins owns the
% scale and its \providecommand wins when the class pulls it in first.
\providecommand{\arthurmarginsize}{\small}
\providecommand{\arthurmargincaptionsize}{\footnotesize}

% caption's font key reads a NAME, not a size command, so the scale is handed
% over through caption's own declaration hook. Passing the macro directly makes
% caption build a control sequence out of it and the document stops.
\DeclareCaptionFont{arthurmargincaption}{\arthurmargincaptionsize}

\newlength{\arthurfullwidth}
\setlength{\arthurfullwidth}{\dimexpr\textwidth+\marginparsep+\marginparwidth\relax}

\makeatletter
\newcommand{\arthur@reset@fullwidth}{%
  \setlength{\arthurfullwidth}{\dimexpr\textwidth+\marginparsep+\marginparwidth\relax}%
}
\AtBeginDocument{\arthur@reset@fullwidth}

\newenvironment{mainfigure}[1][tbp]
  {\begin{figure}[#1]\centering\captionsetup{width=\textwidth}}
  {\end{figure}}

\newenvironment{fullfigure}[1][tbp]
  {%
    \begin{figure}[#1]%
    \arthur@reset@fullwidth
    \begin{adjustwidth}{}{-\dimexpr\marginparsep+\marginparwidth\relax}%
    \centering
    \captionsetup{width=\arthurfullwidth}%
  }
  {%
    \end{adjustwidth}%
    \end{figure}%
  }

% \arthurmarginnote, not \marginpar: margin figures then share one queue with
% margin notes and citations, so a figure and a note anchored to nearby lines
% stack instead of overprinting. It also makes marginfigure legal inside a float
% or a footnote, which \marginpar is not.
\NewEnviron{marginfigure}{%
  \arthurmarginnote{%
    \begin{minipage}{\marginparwidth}%
    % The margin type scale, from arthur-margins: the figure's own text
    % matches the margin notes around it and its caption ranks one step
    % below, so a caption reads as belonging to the figure above it.
    \arthurmarginsize
    \captionsetup{type=figure,font=arthurmargincaption,labelfont=bf}%
    \centering
    \BODY
    \end{minipage}%
  }%
}
\makeatother

\endinput
